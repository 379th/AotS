#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Проверяем адаптивность перед коммитом..."

# Переходим в директорию frontend
cd frontend

# Запускаем проверку адаптивности
npm run check:responsive

# Если проверка не прошла, прерываем коммит
if [ $? -ne 0 ]; then
  echo "❌ Обнаружены проблемы с адаптивностью. Коммит отменен."
  echo "💡 Исправьте проблемы и попробуйте снова."
  exit 1
fi

echo "✅ Проверка адаптивности пройдена успешно!"
