# Dockerfile для сервиса проверки адаптивности
FROM node:18-alpine

WORKDIR /app

# Копируем package.json и package-lock.json
COPY package*.json ./

# Устанавливаем все зависимости (включая dev)
RUN npm ci

# Копируем исходный код
COPY . .

# Создаем директорию для отчетов
RUN mkdir -p /app/reports

# Команда по умолчанию - проверка адаптивности
CMD ["npm", "run", "check:responsive"]
