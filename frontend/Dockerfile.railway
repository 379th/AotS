# Dockerfile для Railway с проверкой адаптивности
FROM node:18-alpine

WORKDIR /app

# Копируем package.json и package-lock.json
COPY package*.json ./

# Устанавливаем все зависимости (включая dev для проверки)
RUN npm ci

# Копируем исходный код
COPY . .

# Запускаем проверку адаптивности перед сборкой
RUN npm run check:responsive || echo "Проверка адаптивности завершена с предупреждениями"

# Собираем приложение
RUN npm run build

# Устанавливаем serve для продакшена
RUN npm install -g serve

# Открываем порт
EXPOSE 3000

# Запускаем приложение
CMD ["serve", "-s", "dist", "-l", "3000"]
