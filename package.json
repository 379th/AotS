{
  "name": "shadow-quest-app",
  "version": "1.0.0",
  "description": "Shadow Quest Telegram Mini App",
  "private": true,
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "cd frontend && npx serve -s dist -l 3000 --single",
    "dev": "cd frontend && npm run dev",
    "check:responsive": "cd frontend && npm run check:responsive",
    "railway:deploy": "cd frontend && npm run railway:deploy",
    "railway:check": "cd frontend && npm run railway:check",
    "railway:setup": "cd frontend && npm run railway:setup"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}